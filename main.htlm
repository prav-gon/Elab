<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>⚡ Electrical Lab Simulator</title>
    <style>
        /* ────────── RESET & BASE ────────── */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #0b0e14;
            color: #e8edf5;
            height: 100vh;
            display: flex;
            overflow: hidden;
        }
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1a1f2a;
        }
        ::-webkit-scrollbar-thumb {
            background: #3a4a6a;
            border-radius: 4px;
        }

        /* ────────── SIDEBAR ────────── */
        #sidebar {
            width: 260px;
            min-width: 260px;
            background: #121821;
            border-right: 1px solid #293241;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 16px 0 20px 0;
            z-index: 10;
        }
        #sidebar .logo {
            padding: 0 18px 18px 18px;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #293241;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #7bb8ff;
        }
        #sidebar .logo span {
            font-size: 26px;
        }
        .nav-item {
            padding: 10px 18px;
            margin: 2px 8px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13.5px;
            font-weight: 500;
            transition: all 0.15s ease;
            color: #9aaec9;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 3px solid transparent;
        }
        .nav-item:hover {
            background: #1e283a;
            color: #d0def0;
        }
        .nav-item.active {
            background: #1a2a44;
            color: #7bb8ff;
            border-left-color: #4a8cf7;
        }
        .nav-item .badge {
            margin-left: auto;
            font-size: 10px;
            background: #1f2a3a;
            padding: 2px 8px;
            border-radius: 12px;
            color: #7a8aa8;
        }
        .nav-item.active .badge {
            background: #2a3f66;
            color: #7bb8ff;
        }
        .nav-section {
            padding: 14px 18px 6px 18px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #4a5a7a;
            font-weight: 600;
        }

        /* ────────── MAIN CONTENT ────────── */
        #main {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #0f151e;
            overflow: hidden;
        }
        #toolbar {
            background: #141c28;
            padding: 10px 24px;
            border-bottom: 1px solid #1f2a38;
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 56px;
            flex-shrink: 0;
        }
        #toolbar h2 {
            font-size: 18px;
            font-weight: 600;
            color: #d0def0;
        }
        #toolbar .exp-sub {
            font-size: 13px;
            color: #6a8aaa;
            font-weight: 400;
            margin-left: 12px;
        }
        #toolbar .actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }
        #toolbar .actions button {
            background: #1f2a3a;
            border: none;
            color: #b0c8e0;
            padding: 6px 16px;
            border-radius: 6px;
            font-size: 12.5px;
            cursor: pointer;
            transition: background 0.15s;
            font-weight: 500;
        }
        #toolbar .actions button:hover {
            background: #2a3a55;
            color: #fff;
        }
        #toolbar .actions button.primary {
            background: #2a4a7a;
            color: #fff;
        }
        #toolbar .actions button.primary:hover {
            background: #3a5a9a;
        }

        #workspace {
            flex: 1;
            display: flex;
            overflow: hidden;
            position: relative;
        }
        #canvas-container {
            flex: 1;
            position: relative;
            background: #0d121c;
            overflow: auto;
        }
        #canvas-container canvas {
            display: block;
            width: 100%;
            height: 100%;
            cursor: crosshair;
        }

        /* ────────── RIGHT PANEL (controls + meters) ────────── */
        #right-panel {
            width: 340px;
            min-width: 340px;
            background: #111822;
            border-left: 1px solid #1f2a38;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 16px 18px;
            gap: 14px;
        }
        #right-panel .panel-section {
            background: #161f2b;
            border-radius: 10px;
            padding: 14px 16px;
            border: 1px solid #1f2a3a;
        }
        #right-panel .panel-section h4 {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #5a7a9a;
            margin-bottom: 10px;
            font-weight: 600;
        }
        .param-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 6px;
            font-size: 13px;
            color: #b0c8e0;
            flex-wrap: wrap;
        }
        .param-row label {
            min-width: 70px;
            font-weight: 500;
            color: #8aa8c8;
        }
        .param-row input[type="range"] {
            flex: 1;
            min-width: 80px;
            accent-color: #4a8cf7;
            background: #1a2535;
            height: 4px;
            border-radius: 4px;
        }
        .param-row input[type="number"] {
            width: 64px;
            background: #0d1520;
            border: 1px solid #1f2a3a;
            border-radius: 4px;
            color: #e8edf5;
            padding: 3px 6px;
            font-size: 13px;
            text-align: center;
        }
        .param-row .value-display {
            min-width: 44px;
            text-align: right;
            font-weight: 600;
            color: #c0d8f0;
            font-size: 14px;
        }
        .meter-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .meter-item {
            background: #0d1520;
            border-radius: 6px;
            padding: 8px 10px;
            text-align: center;
            border: 1px solid #1a2535;
        }
        .meter-item .label {
            font-size: 10px;
            text-transform: uppercase;
            color: #5a7a9a;
            letter-spacing: 0.5px;
        }
        .meter-item .value {
            font-size: 18px;
            font-weight: 700;
            color: #7bb8ff;
            font-family: 'Courier New', monospace;
        }
        .meter-item .unit {
            font-size: 12px;
            color: #6a8aaa;
            margin-left: 2px;
        }
        .meter-item.accent-green .value {
            color: #5cdb9a;
        }
        .meter-item.accent-orange .value {
            color: #f0b86a;
        }
        .meter-item.accent-pink .value {
            color: #e880a0;
        }

        .status-msg {
            font-size: 13px;
            color: #8ab8d8;
            padding: 6px 10px;
            background: #0a121e;
            border-radius: 6px;
            border-left: 3px solid #4a8cf7;
        }

        /* ────────── OSCILLOSCOPE (DSO) ────────── */
        .dso-container {
            background: #080e18;
            border-radius: 8px;
            padding: 8px;
            border: 1px solid #1a2535;
        }
        .dso-container canvas {
            width: 100%;
            height: 140px;
            display: block;
            border-radius: 4px;
            background: #050a12;
        }
        .dso-labels {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            color: #4a6a8a;
            padding: 2px 6px 0 6px;
        }
        .dso-meas {
            display: flex;
            gap: 14px;
            font-size: 12px;
            color: #8aaac8;
            padding: 4px 6px 0 6px;
            flex-wrap: wrap;
        }
        .dso-meas span {
            background: #0a121e;
            padding: 2px 10px;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
        }

        /* ────────── RESPONSIVE ────────── */
        @media (max-width: 1024px) {
            #right-panel {
                width: 280px;
                min-width: 280px;
            }
            #sidebar {
                width: 200px;
                min-width: 200px;
            }
        }
        @media (max-width: 768px) {
            body {
                flex-direction: column;
            }
            #sidebar {
                width: 100%;
                min-width: unset;
                max-height: 200px;
                flex-direction: row;
                flex-wrap: wrap;
                padding: 8px 12px;
                border-right: none;
                border-bottom: 1px solid #1f2a38;
                overflow-y: auto;
                gap: 4px;
            }
            #sidebar .logo {
                width: 100%;
                padding: 0 0 8px 0;
                border-bottom: none;
            }
            .nav-item {
                padding: 6px 12px;
                font-size: 12px;
                margin: 0;
            }
            #right-panel {
                width: 100%;
                min-width: unset;
                max-height: 50vh;
                border-left: none;
                border-top: 1px solid #1f2a38;
            }
            #workspace {
                flex-direction: column;
            }
            #toolbar h2 {
                font-size: 14px;
            }
            .meter-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        /* ────────── TOOLTIP / HINT ────────── */
        .hint {
            font-size: 12px;
            color: #4a6a8a;
            padding: 4px 0;
            font-style: italic;
        }
        .connection-status {
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 4px;
            background: #0a1520;
            color: #6a9ac8;
            border: 1px solid #1a2a40;
        }
        .connection-status .dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 6px;
        }
        .dot.green {
            background: #4cdb8a;
        }
        .dot.red {
            background: #db4a4a;
        }
        .dot.yellow {
            background: #dbca4a;
        }
    </style>
</head>
<body>

    <!-- ═══════════════ SIDEBAR ═══════════════ -->
    <div id="sidebar">
        <div class="logo"><span>⚡</span> Lab<span style="color:#4a8cf7;">Sim</span></div>
        <div class="nav-section">Experiments</div>
        <div id="nav-list"></div>
        <div style="margin-top:auto;padding:12px 18px;font-size:11px;color:#3a4a5a;border-top:1px solid #1a2535;">
            🔌 Click terminals to join wires
        </div>
    </div>

    <!-- ═══════════════ MAIN ═══════════════ -->
    <div id="main">
        <div id="toolbar">
            <div>
                <h2 id="exp-title">Maximum Power Transfer <span class="exp-sub">Experiment 1</span></h2>
            </div>
            <div class="actions">
                <button id="btn-reset" title="Reset circuit">⟳ Reset</button>
                <button id="btn-simulate" class="primary">▶ Simulate</button>
            </div>
        </div>

        <div id="workspace">
            <div id="canvas-container">
                <canvas id="circuitCanvas"></canvas>
            </div>
            <div id="right-panel">
                <!-- dynamically filled -->
            </div>
        </div>
    </div>

    <script>
        // ═══════════════════════════════════════════════════════════════
        //  DATA: All 10 Experiments
        // ═══════════════════════════════════════════════════════════════

        const EXPERIMENTS = [{
            id: 0,
            title: 'Maximum Power Transfer Theorem',
            short: 'Max Power Transfer',
            desc: 'Verify that maximum power is delivered to the load when R<sub>L</sub> = R<sub>th</sub>.',
            params: [
                { key: 'Vs', label: 'V<sub>s</sub>', min: 1, max: 20, step: 0.5, default: 10, unit: 'V' },
                { key: 'Rs', label: 'R<sub>s</sub>', min: 10, max: 200, step: 5, default: 100, unit: 'Ω' },
                { key: 'Rl', label: 'R<sub>L</sub>', min: 5, max: 300, step: 5, default: 50, unit: 'Ω' },
            ],
            meters: [
                { key: 'Vload', label: 'V<sub>L</sub>', unit: 'V', accent: '' },
                { key: 'Iload', label: 'I<sub>L</sub>', unit: 'mA', accent: 'accent-green' },
                { key: 'Pload', label: 'P<sub>L</sub>', unit: 'mW', accent: 'accent-orange' },
                { key: 'eff', label: 'η', unit: '%', accent: 'accent-pink' },
            ],
            status: 'Adjust R<sub>L</sub> to find max power point.',
            // circuit drawing function
            draw: drawMaxPower,
            simulate: simMaxPower,
        }, {
            id: 1,
            title: "Thevenin's Theorem",
            short: 'Thevenin',
            desc: 'Verify Thevenin equivalent: V<sub>th</sub> and R<sub>th</sub> of a network.',
            params: [
                { key: 'Vs', label: 'V<sub>s</sub>', min: 5, max: 30, step: 1, default: 15, unit: 'V' },
                { key: 'R1', label: 'R<sub>1</sub>', min: 10, max: 300, step: 5, default: 100, unit: 'Ω' },
                { key: 'R2', label: 'R<sub>2</sub>', min: 10, max: 300, step: 5, default: 150, unit: 'Ω' },
                { key: 'Rl', label: 'R<sub>L</sub>', min: 5, max: 300, step: 5, default: 100, unit: 'Ω' },
            ],
            meters: [
                { key: 'Vth', label: 'V<sub>th</sub>', unit: 'V', accent: '' },
                { key: 'Rth', label: 'R<sub>th</sub>', unit: 'Ω', accent: 'accent-green' },
                { key: 'Vload', label: 'V<sub>L</sub>', unit: 'V', accent: 'accent-orange' },
                { key: 'Iload', label: 'I<sub>L</sub>', unit: 'mA', accent: 'accent-pink' },
            ],
            status: 'Thevenin equivalent simplifies the network.',
            draw: drawThevenin,
            simulate: simThevenin,
        }, {
            id: 2,
            title: '3-Voltmeter Method (AC)',
            short: '3VM AC',
            desc: 'Measure power & power factor in single-phase AC using three voltmeters.',
            params: [
                { key: 'V', label: 'V<sub>s</sub>', min: 50, max: 300, step: 5, default: 220, unit: 'V' },
                { key: 'R', label: 'R', min: 10, max: 500, step: 5, default: 100, unit: 'Ω' },
                { key: 'L', label: 'L', min: 10, max: 500, step: 10, default: 200, unit: 'mH' },
                { key: 'C', label: 'C', min: 1, max: 100, step: 1, default: 30, unit: 'µF' },
            ],
            meters: [
                { key: 'V1', label: 'V<sub>1</sub> (R)', unit: 'V', accent: '' },
                { key: 'V2', label: 'V<sub>2</sub> (L)', unit: 'V', accent: 'accent-green' },
                { key: 'V3', label: 'V<sub>3</sub> (C)', unit: 'V', accent: 'accent-orange' },
                { key: 'PF', label: 'Power Factor', unit: '', accent: 'accent-pink' },
            ],
            status: 'Use three voltmeters to compute power and PF.',
            draw: drawThreeVoltmeter,
            simulate: simThreeVoltmeter,
        }, {
            id: 3,
            title: '3-Phase Star / Delta',
            short: 'Star-Delta',
            desc: 'Verify line/phase voltage & current relations in 3-phase star and delta.',
            params: [
                { key: 'Vl', label: 'V<sub>line</sub>', min: 100, max: 500, step: 10, default: 400, unit: 'V' },
                { key: 'Z', label: 'Z<sub>phase</sub>', min: 10, max: 300, step: 5, default: 100, unit: 'Ω' },
                { key: 'mode', label: 'Connection', type: 'select', options: ['Star', 'Delta'], default: 'Star' },
            ],
            meters: [
                { key: 'Vp', label: 'V<sub>phase</sub>', unit: 'V', accent: '' },
                { key: 'Ip', label: 'I<sub>phase</sub>', unit: 'A', accent: 'accent-green' },
                { key: 'Il', label: 'I<sub>line</sub>', unit: 'A', accent: 'accent-orange' },
                { key: 'S', label: 'S (apparent)', unit: 'VA', accent: 'accent-pink' },
            ],
            status: 'Star: V<sub>L</sub> = √3·V<sub>P</sub>, I<sub>L</sub> = I<sub>P</sub>  |  Delta: V<sub>L</sub> = V<sub>P</sub>, I<sub>L</sub> = √3·I<sub>P</sub>',
            draw: drawStarDelta,
            simulate: simStarDelta,
        }, {
            id: 4,
            title: 'R-L-C Series Resonance',
            short: 'RLC Resonance',
            desc: 'Study series RLC circuit and find resonance condition (X<sub>L</sub> = X<sub>C</sub>).',
            params: [
                { key: 'Vs', label: 'V<sub>s</sub>', min: 5, max: 50, step: 1, default: 20, unit: 'V' },
                { key: 'R', label: 'R', min: 10, max: 300, step: 5, default: 50, unit: 'Ω' },
                { key: 'L', label: 'L', min: 10, max: 500, step: 10, default: 100, unit: 'mH' },
                { key: 'C', label: 'C', min: 1, max: 100, step: 1, default: 20, unit: 'µF' },
                { key: 'f', label: 'f', min: 10, max: 2000, step: 10, default: 500, unit: 'Hz' },
            ],
            meters: [
                { key: 'XL', label: 'X<sub>L</sub>', unit: 'Ω', accent: '' },
                { key: 'XC', label: 'X<sub>C</sub>', unit: 'Ω', accent: 'accent-green' },
                { key: 'Z', label: '|Z|', unit: 'Ω', accent: 'accent-orange' },
                { key: 'I', label: 'I', unit: 'mA', accent: 'accent-pink' },
                { key: 'f0', label: 'f<sub>0</sub>', unit: 'Hz', accent: '' },
            ],
            status: 'Resonance when X<sub>L</sub> = X<sub>C</sub> → f<sub>0</sub> = 1/(2π√LC)',
            draw: drawRLC,
            simulate: simRLC,
        }, {
            id: 5,
            title: 'Staircase Wiring (2-Way)',
            short: 'Staircase',
            desc: 'Control one lamp from two different places using 2-way switches.',
            params: [
                { key: 'sw1', label: 'Switch 1', type: 'toggle', default: 'up' },
                { key: 'sw2', label: 'Switch 2', type: 'toggle', default: 'up' },
            ],
            meters: [
                { key: 'lamp', label: 'Lamp', unit: '', accent: '' },
                { key: 'state', label: 'State', unit: '', accent: 'accent-orange' },
            ],
            status: 'Toggle either switch to change lamp state.',
            draw: drawStaircase,
            simulate: simStaircase,
        }, {
            id: 6,
            title: 'Bed Switch Wiring (1-Way)',
            short: 'Bed Switch',
            desc: 'Control one lamp from two places using 1-way switches (SPST).',
            params: [
                { key: 'sw1', label: 'Switch 1', type: 'toggle', default: 'off' },
                { key: 'sw2', label: 'Switch 2', type: 'toggle', default: 'off' },
            ],
            meters: [
                { key: 'lamp', label: 'Lamp